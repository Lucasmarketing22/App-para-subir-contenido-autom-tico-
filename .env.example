# OpenAI — used server-side by /api/ai (model: gpt-4o-mini).
# Optional: you can also paste a key in /settings (stored only in your browser).
OPENAI_API_KEY=

# Optional: OpenAI model override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Supabase — optional. If empty, the app stores everything in localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
